# Variables for the LOCAL Telegram Bot API server (`telegram-bot-api` service, image aiogram/telegram-bot-api).
# The server exists so the bot can SEND files up to 2 GB (the public cloud API stops at 50 MB).
#
# Put these lines in the project's .env (docker-compose.yml passes them to the container).
# Names verified against the image README: github.com/aiogram/telegram-bot-api

# 1) Get API_ID / API_HASH once at https://my.telegram.org -> "API development tools" (log in with the
#    phone number of the bot OWNER, create any application). They identify YOUR application, not the bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 2) Serve files from the server's own disk (needed for large uploads/downloads). Set by docker-compose.yml.
TELEGRAM_LOCAL=1

# 3) Where the bot and worker connect (inside the compose network). Already the default in .env.example.
TELEGRAM_API_BASE=http://telegram-bot-api:8081

# Data lives in the named volume `tgapi-data`, mounted at /var/lib/telegram-bot-api (uid/gid 101).
#
# ONE-TIME MIGRATION (only if the bot was ever used with the public cloud API, e.g. during development):
# a bot can talk to only one Bot API server at a time. Log it out of the cloud API BEFORE the first start
# against the local server:
#
#   curl "https://api.telegram.org/bot<BOT_TOKEN>/logOut"
#
# It must return {"ok":true,"result":true}. After that, the cloud API refuses this bot for ~10 minutes; start
# the local server, then the bot. To go BACK to the cloud API, call `/logOut` on the LOCAL server the same way:
#
#   curl "http://localhost:8081/bot<BOT_TOKEN>/logOut"   # from inside the compose network / the VM
